# Copy this file to .env and edit the values for your deployment.
# On Windows PowerShell: copy .env.example .env
# Then start the backend with: python manage.py runserver

# ─── Core security ───────────────────────────────────────────────
# Generate a strong key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string

# Optional: separate signing key for JWT tokens (recommended in production)
# JWT_SIGNING_KEY=another-50-char-random-string

# ─── Runtime mode ───────────────────────────────────────────────
# Set to False in production
DEBUG=True

# Comma-separated list of hosts the server responds to.
# Examples:
#   ALLOWED_HOSTS=localhost,127.0.0.1
#   ALLOWED_HOSTS=flashcards.example.com,api.flashcards.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── CORS ───────────────────────────────────────────────────────
# Set to True to allow ALL origins (dev only!). When True, credentials
# are automatically disabled for browser safety.
CORS_ALLOW_ALL=True

# When CORS_ALLOW_ALL is False, only these origins are allowed.
# Comma-separated list, no trailing slashes.
# Examples:
#   CORS_ALLOWED_ORIGINS=https://example.com
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
# CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ─── Production-only hardening ──────────────────────────────────
# These are only applied when DEBUG=False
# SECURE_SSL_REDIRECT=True  # set if you have TLS terminated at the app
